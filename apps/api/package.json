{
  "name": "@overload/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "tsx --env-file-if-exists=.env.local src/server.ts",
    "typecheck": "tsc --noEmit --checkers 4",
    "test": "vitest run",
    "contract": "tsx scripts/generate-openapi.ts",
    "seed:exercises": "tsx seed/exercises.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "vercel-build": "sh scripts/vercel-build.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.9",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}

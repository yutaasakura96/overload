# Copy to .env.local. Local only: Docker Postgres from the repo's docker-compose.yml, never Neon.

# Runtime connection, as the app role (docs/13 §5).
DATABASE_URL=postgres://overload_app:overload_app_dev@localhost:5434/overload
# `pnpm db:migrate` (drizzle-kit, through drizzle.config.ts), as the owner role.
DATABASE_URL_DIRECT=postgres://overload_owner:overload_owner_dev@localhost:5434/overload?sslmode=disable

# The web origin: the API is reached through the web app's /api proxy (docs/03 §5).
BETTER_AUTH_URL=http://localhost:5173
# At least 32 random characters: `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# The OAuth client's third redirect URI is http://localhost:5173/api/auth/callback/google (docs/12 §1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

PORT=8787

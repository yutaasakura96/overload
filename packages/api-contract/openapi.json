{
  "openapi": "3.1.0",
  "security": [
    {
      "session": []
    },
    {
      "bearer": []
    }
  ],
  "info": {
    "title": "Overload API",
    "version": "1",
    "description": "Generated from the route schemas in apps/api by `pnpm contract`. Do not edit by hand. Better Auth’s own /api/auth/* routes are not described here."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth’s session cookie, set on the web origin. `__Secure-` prefixed over HTTPS."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The session token from the `set-auth-token` header, for the native client."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "image"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "user",
          "isAdmin",
          "profile"
        ]
      },
      "Profile": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "example": "Asia/Tokyo"
          },
          "heightCm": {
            "type": [
              "number",
              "null"
            ]
          },
          "sex": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "male",
              "female",
              null
            ]
          },
          "birthDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "trainingWeekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "description": "ISO weekdays, 1 = Monday."
          }
        },
        "required": [
          "timezone",
          "heightCm",
          "sex",
          "birthDate",
          "trainingWeekdays"
        ],
        "description": "Null until the user has set one up."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:overload:problem:unauthenticated"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable and machine-readable. Clients switch on this."
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            },
            "description": "Present only for `validation_failed`."
          },
          "routines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            "description": "Present only for `exercise_in_routine`: the routines using it."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ]
      },
      "ExerciseList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Exercise"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Exercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
          },
          "name": {
            "type": "string",
            "example": "Barbell Bench Press"
          },
          "equipment": {
            "$ref": "#/components/schemas/Equipment"
          },
          "custom": {
            "type": "boolean",
            "description": "True for the caller’s own exercise, false for a seeded one."
          },
          "hidden": {
            "type": "boolean"
          },
          "incrementKg": {
            "type": "number",
            "example": 2.5
          },
          "restSeconds": {
            "type": "integer",
            "example": 180
          },
          "repLow": {
            "type": "integer",
            "example": 6
          },
          "repHigh": {
            "type": "integer",
            "example": 10
          },
          "overrides": {
            "type": "object",
            "properties": {
              "incrementKg": {
                "type": "boolean"
              },
              "restSeconds": {
                "type": "boolean"
              },
              "repLow": {
                "type": "boolean"
              },
              "repHigh": {
                "type": "boolean"
              }
            },
            "required": [
              "incrementKg",
              "restSeconds",
              "repLow",
              "repHigh"
            ],
            "description": "Which values are the caller’s own settings rather than defaults."
          }
        },
        "required": [
          "id",
          "name",
          "equipment",
          "custom",
          "hidden",
          "incrementKg",
          "restSeconds",
          "repLow",
          "repHigh",
          "overrides"
        ]
      },
      "Equipment": {
        "type": "string",
        "enum": [
          "barbell",
          "dumbbell",
          "machine_plate",
          "machine_stack",
          "cable",
          "bodyweight",
          "other"
        ],
        "description": "A load-increment class, not an equipment inventory (docs/04 `exercise`)."
      },
      "ExerciseCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11",
            "description": "Made on the device (UUIDv7). A repeat returns the row."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Cable Y-Raise"
          },
          "equipment": {
            "$ref": "#/components/schemas/Equipment"
          },
          "incrementKg": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 2.5,
            "description": "Default: the equipment class’s increment (docs/04 `exercise`)."
          },
          "restSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600,
            "example": 120,
            "description": "Default 120."
          },
          "repLow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Default 6."
          },
          "repHigh": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Default 10."
          }
        },
        "required": [
          "id",
          "name",
          "equipment"
        ]
      },
      "ExercisePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "equipment": {
            "$ref": "#/components/schemas/Equipment"
          },
          "incrementKg": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 2.5
          },
          "restSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600,
            "example": 120
          },
          "repLow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "repHigh": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "ExerciseSetting": {
        "type": "object",
        "properties": {
          "incrementKg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "example": 2.5
          },
          "restSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3600,
            "example": 120
          },
          "repLow": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "repHigh": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "hidden": {
            "type": "boolean",
            "description": "Off the caller’s pickers; history still names it."
          }
        },
        "required": [
          "incrementKg",
          "restSeconds",
          "repLow",
          "repHigh",
          "hidden"
        ],
        "description": "The whole setting. `null` restores the exercise’s default for that value."
      },
      "RoutineList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Routine"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Routine": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
          },
          "name": {
            "type": "string",
            "example": "Push A"
          },
          "position": {
            "type": "integer",
            "description": "Place in the routine list, 0 first."
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutineSlot"
            },
            "description": "In order."
          }
        },
        "required": [
          "id",
          "name",
          "position",
          "exercises"
        ]
      },
      "RoutineSlot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
          },
          "exerciseId": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
          },
          "targetSets": {
            "type": "integer",
            "example": 3
          },
          "repLow": {
            "type": [
              "integer",
              "null"
            ]
          },
          "repHigh": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "exerciseId",
          "targetSets",
          "repLow",
          "repHigh"
        ],
        "description": "Null reps fall back to the caller’s setting, then the exercise’s default."
      },
      "RoutineCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11",
            "description": "Made on the device (UUIDv7). A repeat returns the routine."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Push A"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutineSlotInput"
            },
            "maxItems": 40
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RoutineSlotInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11",
            "description": "Made on the device (UUIDv7)."
          },
          "exerciseId": {
            "type": "string",
            "format": "uuid",
            "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
          },
          "targetSets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Default 3."
          },
          "repLow": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "repHigh": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "exerciseId"
        ]
      },
      "RoutinePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "description": "Move to this place in the list, 0 first; past the end means last."
          }
        }
      },
      "RoutineExercisesPut": {
        "type": "object",
        "properties": {
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutineSlotInput"
            },
            "maxItems": 40
          }
        },
        "required": [
          "exercises"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness. Answers without touching the database",
        "security": [],
        "responses": {
          "200": {
            "description": "The function is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "The signed-in user, their profile, and whether they are the admin",
        "responses": {
          "200": {
            "description": "The caller",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises": {
      "get": {
        "summary": "Seeded exercises plus the caller’s own, with the caller’s effective settings, by name",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "Include exercises the caller has hidden. Default `false`."
            },
            "required": false,
            "description": "Include exercises the caller has hidden. Default `false`.",
            "name": "includeHidden",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The library",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseList"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter of the wrong type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a custom exercise, visible only to the caller",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A repeat of the same create: the stored exercise",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`id_conflict`: the id is in use with different content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, including an inverted rep range or a name in use",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises/{id}": {
      "patch": {
        "summary": "Edit a custom exercise’s name, equipment or defaults. A seeded one is not found",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExercisePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The exercise as the caller now sees it",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "400": {
            "description": "A malformed id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No custom exercise with that id belongs to the caller",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, including an inverted rep range or a name in use",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a custom exercise. 204 whenever the caller has no such exercise afterwards",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The caller has no custom exercise with that id",
            "headers": {
              "Overload-User": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The id of the user whose session answered. Keep the body for that account only."
                },
                "required": true,
                "description": "The id of the user whose session answered. Keep the body for that account only."
              }
            }
          },
          "400": {
            "description": "A malformed id",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`exercise_in_routine`, listing the routines that use it",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises/{id}/setting": {
      "put": {
        "summary": "The caller’s increment, rest, rep range and hidden flag for any exercise",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "0192a001-7c1e-7a33-9c2d-4b6f1e0a9d11"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
